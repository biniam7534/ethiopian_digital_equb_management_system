NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=equb_db
DB_USER=equb_user
DB_PASSWORD=equb_password

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# SMS gateway (e.g. Africa's Talking / custom provider)
SMS_ENABLED=false
SMS_API_URL=https://api.example-sms.com/send
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=EQUB

# Firebase Cloud Messaging
FCM_ENABLED=false
# Path to service account JSON, or leave empty and use GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT_PATH=

# CORS — comma-separated origins; * for development
CORS_ORIGIN=*
